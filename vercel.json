{
    "version": 2,
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/development",
            "destination": "/assets/pages/development"
        }
    ],
    "trailingSlash": false,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ]
}